{
  "schema_version": 1,
  "execution_scope": "provision_only",
  "private_root": "/run/user-admin-private",
  "instances": [
    {
      "service": "gitlab",
      "instance": "primary",
      "origin": "https://gitlab.example.invalid",
      "acceptance_profile": "gitlab-18.1.0-ce-ban-v1",
      "credentials": { "token_file": "gitlab-token" }
    },
    {
      "service": "matrix",
      "instance": "primary",
      "origin": "https://matrix.example.invalid",
