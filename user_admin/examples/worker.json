      "credentials": {
        "token_file": "matrix-token",
        "registration_secret_file": "matrix-registration"
      }
    },
    {
      "service": "minio",
      "instance": "primary",
      "origin": "https://minio.example.invalid",
      "acceptance_profile": "minio-2023-05-18-owned-s3-v1",
      "credentials": {
        "access_key_file": "minio-access-key",
        "secret_key_file": "minio-secret-key"
      }
    }
  ]
}
