      "credentials": {
        "token_file": "matrix-token",
        "registration_secret_file": "matrix-registration"
      }
    },
    {
      "service": "minio",
      "instance": "primary",
      "origin": "http://minio.public-page.svc.cluster.local:9000",
      "transport": "cluster_http",
      "acceptance_profile": "minio-2023-05-18-owned-s3-v1",
      "credentials": {
        "access_key_file": "minio-access",
        "secret_key_file": "minio-secret"
      }
    }
