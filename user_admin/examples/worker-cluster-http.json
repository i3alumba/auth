  "instances": [
    {
      "service": "gitlab",
      "instance": "primary",
      "origin": "http://gitlab.public-page.svc.cluster.local",
      "transport": "cluster_http",
      "acceptance_profile": "gitlab-18.1.0-ce-ban-v1",
      "credentials": { "token_file": "gitlab-token" }
    },
    {
      "service": "matrix",
      "instance": "primary",
      "origin": "http://synapse.public-page.svc.cluster.local:8008",
